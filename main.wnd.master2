
\begin{theindex}\indexnote{ Order of languages:\\
 \textbf{Proto-Indo-European},\\
 \textbf{Anatolian} (Proto-Anatolian, Palaic, Hittite, Cuneiform Luwian, Hieroglyphic Luwian, Lycian, Lydian),\\
 \textbf{Tocharian} (Common Tocharian, Tocharian A, Tocharian B),\\
 \textbf{Indo-Iranian }(Proto-Indo-Iranian, Sanskrit, Proto-Iranian, Avestan, Khotanese, Ossetic, Old Persian, Middle Persian, Pashto),\\
 \textbf{Armenian} (Proto-Armenian, Classical Armenian),\\
 \textbf{Greek} (Proto-Greek, Mycenaean Greek, Ancient Greek, Modern Greek),\\
 \textbf{Italic} (Oscan, Latin, Italian, Spanish),\\
 \textbf{Celtic} (Proto-Celtic, Proto-Goidelic, Gaulish, Ogam Irish, Old Irish, Middle Irish, Modern Irish, Proto-British, Old British, Old Breton, Middle Breton, Modern Breton, Old Cornish, Middle Cornish, Modern Cornish, Old Welsh, Middle Welsh, Modern Welsh),\\
 \textbf{Germanic} (Proto-Germanic, Gothic, Langobardic, Proto-Norse, Old (West) Norse, Old Danish, Old Swedish, Modern Norwegian, Old English, Middle English, Old Frisian, Old Saxon, Old High German, Middle High German, Early New High German, New High German,  Middle Low German),\\
 \textbf{Balto-Slavic} (Proto-Balto-Slavic, Proto-Baltic, Old Prussian, Old Lithuanian, Modern Lithuanian, Latvian, Proto- and Common Slavic, Old Church Slavonic, Russian Church Slavonic, Old Russian, Modern Russian, Czech, Polish,\\
 Serbo-Croatian),\\
 \textbf{Albanian} (Proto-Albanian, Albanian),\\
 \textbf{Akkadian},\\
 \textbf{Hebrew}.\\\smallskip

 English alphabetical order is followed unless otherwise indicated.\bigskip
